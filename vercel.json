{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "reset-assessment.vercel.app" }
      ],
      "destination": "https://reset.happyeverafter.asia/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
